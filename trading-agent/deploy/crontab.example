# Trading agent schedule. Times are ET; CRON_TZ makes DST someone else's problem.
CRON_TZ=America/New_York

# Trading cycles every 20 minutes, 09:45 -> 15:25, weekdays.
# The first slot is 09:45 (clears the 15-minute opening blackout) and the last
# is 15:25 (clears the 20-minute closing blackout). The gate enforces both
# regardless, but there is no point paying for an LLM call that cannot trade.
45      9     * * 1-5   /usr/local/bin/tagent-run cycle >> /var/log/tagent/cycle.log 2>&1
5,25,45 10-14 * * 1-5   /usr/local/bin/tagent-run cycle >> /var/log/tagent/cycle.log 2>&1
5,25    15    * * 1-5   /usr/local/bin/tagent-run cycle >> /var/log/tagent/cycle.log 2>&1

# Nightly review - the journal. Once, after the close.
30 17 * * 1-5           /usr/local/bin/tagent-run review >> /var/log/tagent/review.log 2>&1

# Auth health check before the open, so a lapsed OAuth token is something you
# learn at 8am rather than infer from a day of silence.
0 8 * * 1-5             /usr/local/bin/tagent-run health >> /var/log/tagent/health.log 2>&1

# ---------------------------------------------------------------- the loop --
# Publish redacted telemetry, then pull and deploy. Both run after the close and
# in that order, 45 minutes apart:
#
#   17:30  review     writes tonight's lessons and setup statistics
#   17:45  publish    pushes what the review just produced to `agent-status`
#   18:30  pull       deploys any new commit, having proved it first
#
# 17:45 is late enough that the review has finished and early enough that the
# status file describes the commit that actually traded today, not the one
# deployed 45 minutes later. The deploy goes last because it is the only job
# here that can leave the box worse than it found it.
45 17 * * 1-5           /usr/local/bin/tagent-run-script publish-status >> /var/log/tagent/publish.log 2>&1
30 18 * * 1-5           /usr/local/bin/tagent-run-script pull-deploy    >> /var/log/tagent/deploy.log 2>&1

# Note on half-days: the 13:00 ET closes are handled in code (clock.py), not
# here. Cron still fires at 13:05 on those days; the cycle exits immediately.
